# Database — same DB as super-app-chonburi-go
DB_DSN="postgres://user:password@host:5432/dbname?sslmode=disable"

# Server
PORT=8081

# JWT
JWT_SECRET=your-jwt-secret-key

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8081/api/v1/auth/google/callback

# OAuth — Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URL=http://localhost:8081/api/v1/auth/facebook/callback

# Org Info
ORG_NAME=องค์การบริหารส่วนจังหวัดชลบุรี
ORG_LOGO_URL=

# CCTV Partner Integration (Unified Handshake System)
CCTV_PARTNER_API_KEY=your-high-entropy-partner-secret-key
CCTV_PARTNER_PORTAL_URL=https://cctv-partner.com/portal
CCTV_ALLOWED_CALLBACKS=https://cctv-partner.com/portal,https://cctv.chonburi.go.th/portal
CCTV_TICKET_TTL_SECONDS=60
CCTV_VERIFY_RATE_LIMIT=60
CCTV_HANDSHAKE_RATE_LIMIT=10
THAIID_QR_GATEWAY_URL=https://thaid.dopa.go.th/oauth/authorize
PH6_CLIENT_ID=ph6_app_id
PH6_CLIENT_SECRET=ph6_secret_key
